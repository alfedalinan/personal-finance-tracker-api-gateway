{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "TimeoutSeconds": 30,
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/auth" },
          { "ResponseHeader": "Server", "Remove": true },
          { "ResponseHeader": "X-Powered-By", "Remove": true }
        ]
      },
      "api-route": {
        "ClusterId": "finance-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Metadata": {
          "AuthorizationPolicy": "RequireFinanceRead"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "ResponseHeader": "Server", "Remove": true },
          { "ResponseHeader": "X-Powered-By", "Remove": true }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://auth.example.com"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ServiceProviderPolicy",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "ServiceProviderPolicy",
            "ReactivationPeriod": "00:01:00"
          }
        }
      },
      "finance-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://api.example.com"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ServiceProviderPolicy",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "ServiceProviderPolicy",
            "ReactivationPeriod": "00:01:00"
          }
        }
      }
    }
  },
  "Authentication": {
    "Authority": "https://auth.example.com",
    "Audience": "personal-finance-api",
    "ClientId": "api-gateway",
    "ClockSkewMinutes": 5,
    "ValidateLifetime": true,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateIssuerSigningKey": true
  },
  "Authorization": {
    "Policies": {
      "RequireFinanceRead": {
        "Scopes": [ "finance.read" ],
        "Roles": [ "FinanceReader", "Admin" ]
      },
      "RequireFinanceWrite": {
        "Scopes": [ "finance.write" ],
        "Roles": [ "FinanceWriter", "Admin" ]
      },
      "RequireAdmin": {
        "Roles": [ "Admin" ]
      }
    }
  },
  "DownstreamServices": {
    "UserService": "https://auth.example.com",
    "TransactionService": "https://api.example.com"
  }
}
