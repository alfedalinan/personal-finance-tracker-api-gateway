{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "TimeoutSeconds": 30,
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "api-route": {
        "ClusterId": "finance-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://auth.example.com"
          }
        }
      },
      "finance-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://api.example.com"
          }
        }
      }
    }
  },
  "Authentication": {
    "Authority": "https://auth.example.com",
    "Audience": "personal-finance-api",
    "ClientId": "api-gateway"
  },
  "DownstreamServices": {
    "UserService": "https://auth.example.com",
    "TransactionService": "https://api.example.com"
  }
}
