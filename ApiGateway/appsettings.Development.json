{
  "AllowedOrigins": [
    "https://localhost:3000",
    "https://localhost:5000"
  ],
  "MaxRequestBodySize": 31457280,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.IdentityModel": "Debug"
    }
  },
  "ReverseProxy": {
    "TimeoutSeconds": 30,
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Metadata": {
          "RateLimiterPolicy": "strict-write-auth"
        },
        "Transforms": [
          { "PathRemovePrefix": "/auth" },
          { "PathPrefix": "/api/auth" },
          { "ResponseHeader": "Server", "Set": "" },
          { "ResponseHeader": "X-Powered-By", "Set": "" }
        ]
      },
      "api-route": {
        "ClusterId": "finance-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Metadata": {
          "RateLimiterPolicy": "standard-read"
        },
        "Transforms": [
          { "ResponseHeader": "Server", "Set": "" },
          { "ResponseHeader": "X-Powered-By", "Set": "" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:3000"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "ReactivationPeriod": "00:01:00"
          }
        }
      },
      "finance-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5088"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "ReactivationPeriod": "00:01:00"
          }
        }
      }
    }
  },
  "TenantHeader": {
    "HeaderName": "X-Tenant-ID",
    "ClaimFallbacks": [ "tenantId", "tenant_id", "tid" ]
  },
  "Authentication": {
    "Authority": "http://localhost:3000/auth/verify",
    "Audience": "personal-finance-api",
    "ClientId": "api-gateway-dev",
    "ClockSkewMinutes": 5,
    "ValidateLifetime": true,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateIssuerSigningKey": true
  },
  "DownstreamServices": {
    "UserService": "http://localhost:3000",
    "TransactionService": "http://localhost:5088"
  },
  "RateLimiting": {
    "Enabled": true,
    "StandardRead": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "StrictWriteAuth": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  }
}
